# Copy this file to .env and fill in your local credentials.
# .env is loaded automatically by config.py (via python-dotenv) if present.
# Never commit your actual .env file to GitHub -- only .env.example.

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=expense_tracker
MYSQL_PORT=3306

POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DATABASE=expense_tracker
POSTGRES_PORT=5432

MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=expense_tracker

SQLITE_PATH=expenses_sqlite.db
